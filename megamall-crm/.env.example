# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080
SERVER_READ_TIMEOUT=10s
SERVER_WRITE_TIMEOUT=10s
SERVER_SHUTDOWN_TIMEOUT=30s
GIN_MODE=debug   # debug | release
# CORS_ORIGINS — comma-separated allowed origins. Empty = allow all (dev only).
# Production/staging: set explicitly, e.g. https://app.example.com
CORS_ORIGINS=

# APP_TIMEZONE — IANA name for the business timezone. Every business-day
# boundary derives from it: "today" filters, daily revenue buckets, month-to-date
# commissions. Defaults to Asia/Dushanbe (UTC+5, no DST) when left UNSET.
# Do not set it to an empty value — that bypasses the default and is rejected at
# startup rather than silently falling back to UTC. Timestamps are stored as UTC
# regardless; this only controls how days are bucketed and how bare YYYY-MM-DD
# params are interpreted.
# APP_TIMEZONE=Asia/Dushanbe

# ── Database ──────────────────────────────────────────────────────────────────
DB_DSN=host=localhost port=5432 user=megamall password=changeme dbname=megamall_crm sslmode=disable TimeZone=UTC
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=1m
DB_SLOW_QUERY_MS=200

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=change-me-generate-with-openssl-rand-hex-64
JWT_REFRESH_SECRET=change-me-different-secret-generate-with-openssl-rand-hex-64
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Media pipeline (internal/media) ────────────────────────────────────────────
# Master switch — defaults to false. Leave unset/false in production until the
# feature is explicitly reviewed and rolled out; the app starts and the legacy
# /uploads endpoint works identically either way.
MEDIA_PIPELINE_ENABLED=false
# Required only when MEDIA_PIPELINE_ENABLED=true. Generate with: openssl rand -hex 32
MEDIA_SIGNING_SECRET=

# ── Telegram budget-withdrawal approval (internal/telegram, internal/budget) ──
# Master switch — defaults to false. Owner withdrawals post directly to the
# ledger as before until this is explicitly turned on with real credentials.
TELEGRAM_APPROVAL_ENABLED=false
# Bot token from @BotFather. Required when TELEGRAM_APPROVAL_ENABLED=true.
TELEGRAM_BOT_TOKEN=
# Chat the Approve/Reject message is sent to.
TELEGRAM_APPROVAL_CHAT_ID=
# Comma-separated Telegram user IDs allowed to press Approve/Reject, even
# within the configured chat (e.g. 7927418458 or 111111,222222).
TELEGRAM_ALLOWED_USER_IDS=
# Arbitrary secret registered with Telegram's setWebhook secret_token; incoming
# webhook calls are rejected unless X-Telegram-Bot-Api-Secret-Token matches.
# Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# How long a pending withdrawal waits for a button press before auto-expiring.
TELEGRAM_APPROVAL_TIMEOUT=24h

# ── Telegram DB backups (scripts/backup_db_telegram.sh) ───────────────────────
# Read directly by the megamall-crm-backup systemd timer (see
# scripts/setup_backup_remote.sh), NOT by the Go server — use a bot
# dedicated to backups, separate from the approval bot above, since it
# needs permission to receive full database dumps.
# Bot token from @BotFather.
TELEGRAM_BACKUP_BOT_TOKEN=
# Chat the daily dump is delivered to.
TELEGRAM_BACKUP_CHAT_ID=

# ── Postgres password (docker-compose only) ───────────────────────────────────
POSTGRES_PASSWORD=changeme
REDIS_PASSWORD=changeme

# ── Seed ──────────────────────────────────────────────────────────────────────
# SEED_MODE: dev | staging | production  (default: dev)
#   dev         — all demo users, password123 allowed
#   staging     — all demo users, explicit password required
#   production  — owner only, explicit password required
SEED_MODE=dev
# Password for all non-owner demo users (dev default: password123)
SEED_DEFAULT_PASSWORD=
# Password for the owner account (dev default: same as SEED_DEFAULT_PASSWORD)
SEED_OWNER_PASSWORD=
