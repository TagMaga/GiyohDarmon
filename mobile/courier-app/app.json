{
  "expo": {
    "name": "MegaMall Courier",
    "slug": "megamall-courier",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ec4899"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "tj.megamall.courier",
      "infoPlist": {
        "NSCameraUsageDescription": "Для фото подтверждения оплаты",
        "NSPhotoLibraryUsageDescription": "Для загрузки фото квитанций"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ec4899"
      },
      "package": "tj.megamall.courier",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-updates",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ec4899"
        }
      ]
    ],
    "scheme": "megamall-courier",
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/5f020a78-04d3-47c7-9991-3047d864855c"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5f020a78-04d3-47c7-9991-3047d864855c"
      }
    },
    "owner": "mahmadnazaralif"
  }
}
